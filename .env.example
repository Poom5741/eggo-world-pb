# EggO PocketBase - Production Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to git

# Google OAuth Configuration
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Wallet API Configuration
# Generate with: openssl rand -base64 32
WALLET_MASTER_KEY=your_master_key_min_32_chars_here

# DACC Wallet Configuration
DACC_MNEMONIC=your_dacc_mnemonic_phrase_here

# PocketBase Admin Credentials
# Use strong credentials for production (min 12 chars for password)
POCKETBASE_ADMIN_EMAIL=admin@eggoworld.io
POCKETBASE_ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Configuration
# Set to your production domain (e.g., https://eggoworld.io)
CORS_ORIGIN=https://yourdomain.com

# Wallet API Configuration
NODE_ENV=production
PORT=3001

# Blockchain RPC (for contract deployment and interactions)
# Get from QuickNode, Infura, Alchemy, or similar
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Contract Deployment (NEVER commit real private keys)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Frontend Configuration
NEXT_PUBLIC_POCKETBASE_URL=https://pb.eggoworld.io
NEXT_PUBLIC_WALLET_API_URL=https://wallet.eggoworld.io
NEXT_PUBLIC_CONTRACT_ADDRESSES_JSON_PATH=/contract-addresses.json
