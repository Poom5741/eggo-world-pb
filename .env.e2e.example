# E2E Test Environment Configuration
# Phase 41: Framework Setup + Docker Environment
#
# Copy this file to .env.e2e and modify for local testing:
#   cp .env.e2e.example .env.e2e
#
# NEVER commit .env.e2e with real credentials!

# ===========================================
# Service URLs (Docker Compose defaults)
# ===========================================

# PocketBase backend URL
POCKETBASE_URL=http://localhost:8090

# Wallet API URL (gas sponsorship)
WALLET_API_URL=http://localhost:3001

# Anvil RPC URL (BSC testnet fork)
ANVIL_RPC_URL=http://localhost:8545

# Frontend URL (static export)
E2E_BASE_URL=http://localhost:3000

# ===========================================
# Blockchain Configuration
# ===========================================

# Egg NFT contract address (from BSC testnet deployment)
EGG_NFT_ADDRESS=0xb2FE193523A1E6A240141331A80755f5642e7A44

# Marketplace contract address (optional - set if deployed)
MARKETPLACE_ADDRESS=

# ===========================================
# Admin Credentials (for test user injection)
# ===========================================

# PocketBase admin email for E2E tests
PB_ADMIN_EMAIL=test@e2e.local

# PocketBase admin password (CHANGE THIS!)
PB_ADMIN_PASSWORD=test-password-change-me

# ===========================================
# Wallet API Configuration
# ===========================================

# Master key for wallet encryption (CHANGE THIS!)
WALLET_MASTER_KEY=development-key-change-in-production

# DACC mnemonic for gas sponsorship (use test mnemonic only!)
# WARNING: Never use production mnemonic in E2E tests
DACC_MNEMONIC=test test test test test test test test test test test junk

# ===========================================
# Optional Settings
# ===========================================

# LINE OAuth (disabled for E2E - auth bypass in Phase 42)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Test user IDs (set after creating test users in Phase 42)
SELLER_USER_ID=
BUYER_USER_ID=