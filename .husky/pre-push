#!/usr/bin/env sh

# Ensure bun/bunx is available (Homebrew path on macOS)
export PATH="/opt/homebrew/bin:$HOME/.bun/bin:$PATH"

# Pre-push quality gate
# Quick smoke test before pushing (full test suite runs in CI)

echo "Running pre-push checks..."

# Track test failures
FAILED=0

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Run a single quick test to verify build integrity
echo "Running smoke test..."
(cd "$SCRIPT_DIR/apps/web" && bun test app/page.test.tsx app/layout.test.tsx --timeout 10000) || FAILED=1

if [ $FAILED -ne 0 ]; then
  echo "❌ Tests failed. Push rejected."
  exit 1
fi

echo "✅ Pre-push checks passed. Pushing..."
