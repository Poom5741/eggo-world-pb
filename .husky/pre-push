#!/usr/bin/env sh

# Ensure bun/bunx is available (Homebrew path on macOS)
export PATH="/opt/homebrew/bin:$HOME/.bun/bin:$PATH"

# Pre-push quality gate
# Run unit tests before pushing (integration tests skipped - require external services)

echo "Running tests before push..."

# Track test failures
FAILED=0

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Run web tests (only project tests, exclude node_modules)
echo "Running web tests..."
(cd "$SCRIPT_DIR/apps/web" && bun test app/ components/ hooks/ lib/ --timeout 30000) || FAILED=1

# Run backend tests (only unit tests)
echo "Running backend tests..."
if [ -d "$SCRIPT_DIR/apps/backend" ]; then
  echo "  Running backend unit tests only..."
  (cd "$SCRIPT_DIR/apps/backend" && bun test test/field-migration.test.js --timeout 10000) || FAILED=1
else
  echo "⚠️  Backend directory not found, skipping..."
fi

if [ $FAILED -ne 0 ]; then
  echo "❌ Tests failed. Push rejected."
  exit 1
fi

echo "✅ All tests passed. Pushing..."
