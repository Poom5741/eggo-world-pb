{
  "name": "eggo-world",
  "version": "1.0.0",
  "private": true,
  "description": "EggoWorld - NFT Membership System with LINE OAuth",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "install": "bun install",
    "dev-local": "NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090 bun run --cwd apps/web dev",
    "prepare": "husky",
    "lint": "bun run --cwd apps/web lint",
    "test": "bun run --cwd apps/web test",
    "test:coverage": "bun run --cwd apps/web test:coverage",
    "test:e2e": "playwright test",
    "format": "bunx prettier --write \"**/*.{json,md}\""
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "sh -c 'cd apps/web && bun run lint'"
    ],
    "apps/web/**/*.{js,jsx}": [
      "sh -c 'cd apps/web && bun run lint'"
    ],
    "**/*.{json,md}": [
      "bunx prettier --write"
    ],
    "contracts/**/*.sol": [
      "echo '✓ Solidity files - run forge fmt manually if needed'"
    ],
    "wallet-api/**/*.js": [
      "echo '✓ Wallet API - ensure manual review'"
    ],
    "apps/backend/pb_hooks/**/*.js": [
      "echo '✓ PocketBase hooks - ensure manual review'"
    ]
  },
  "dependencies": {
    "@playwright/test": "^1.59.1"
  },
  "devDependencies": {
    "ethers": "^6.16.0"
  }
}
