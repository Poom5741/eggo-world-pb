      }
    },
    {
      "name": "tx_hash",
      "type": "text",
      "required": false,
      "unique": false,
      "options": {
        "pattern": "^0x[a-fA-F0-9]{64}$"
      }
    },
    {
      "name": "description",
      "type": "text",
      "required": false,
      "unique": false,
      "options": {
        "pattern": ""
      }
    }
  ],
  "listRule": null,
  "viewRule": null,
  "createRule": null,
  "updateRule": null,
  "deleteRule": null,
  "options": {},
  "indexes": []
