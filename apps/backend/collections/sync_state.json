{
  "name": "sync_state",
  "type": "base",
  "system": false,
  "schema": [
    {
      "name": "id",
      "type": "text",
      "required": true,
      "unique": true,
      "options": {
        "pattern": "^config$"
      }
    },
    {
      "name": "lastProcessedBlock",
      "type": "number",
      "required": true,
      "options": {
        "min": 0
      }
    },
    {
      "name": "lastSyncTimestamp",
      "type": "date",
      "required": false,
      "options": {}
    },
    {
      "name": "status",
      "type": "select",
      "required": false,
      "options": {
        "values": ["syncing", "error", "idle"]
      }
    },
    {
      "name": "last_error",
      "type": "text",
      "required": false,
      "options": {}
    },
    {
      "name": "failed_block",
      "type": "number",
      "required": false,
      "options": {
        "min": 0
      }
    }
  ]
}
