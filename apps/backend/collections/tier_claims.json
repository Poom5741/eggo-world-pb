{
  "name": "tier_claims",
  "type": "base",
  "system": false,
  "schema": [
    {
      "name": "user",
      "type": "relation",
      "required": true,
      "unique": false,
      "options": {
        "collectionId": "_pb_users_auth_",
        "cascadeDelete": true,
        "minSelect": null,
        "maxSelect": 1,
        "displayFields": null
      }
    },
    {
      "name": "tier",
      "type": "select",
      "required": true,
      "unique": false,
      "options": {
        "maxSelect": 1,
        "values": ["seedling", "grower", "farmer"]
      }
    },
    {
      "name": "usdt_amount",
      "type": "number",
      "required": true,
      "unique": false,
      "options": {
        "min": 0,
        "max": null
      }
    },
    {
      "name": "tx_hash",
      "type": "text",
      "required": true,
      "unique": false,
      "options": {
        "pattern": "^0x[a-fA-F0-9]{64}$"
      }
    },
    {
      "name": "token_id",
      "type": "number",
      "required": true,
      "unique": false,
      "options": {
        "min": 1,
        "max": 3
      }
    },
    {
      "name": "claimed_at",
      "type": "date",
      "required": true,
      "unique": false,
      "options": {}
    }
  ],
  "indexes": [
    "CREATE UNIQUE INDEX `idx_tier_claims_user_tier` ON `tier_claims` (`user`, `tier`)",
    "CREATE INDEX `idx_tier_claims_tx_hash` ON `tier_claims` (`tx_hash`)",
    "CREATE INDEX `idx_tier_claims_claimed_at` ON `tier_claims` (`claimed_at`)"
  ],
  "listRule": "@request.auth.id != \"\" && user = @request.auth.id",
  "viewRule": "@request.auth.id != \"\" && user = @request.auth.id",
  "createRule": "@request.auth.id != \"\"",
  "updateRule": "",
  "deleteRule": "",
  "options": {}
}
