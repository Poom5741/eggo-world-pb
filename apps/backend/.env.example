# Environment Variables for eggo-pb
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================
# Wallet Encryption
# ============================================
# CRITICAL: This key encrypts all private keys
# Generate with: openssl rand -hex 32
# Store securely and back up!
WALLET_MASTER_KEY=development_key_change_in_production_32_chars_min

# ============================================
# Application Configuration
# ============================================
APP_NAME=eggo-pb
APP_URL=http://localhost:8090
NODE_ENV=development

# ============================================
# PocketBase Configuration (optional)
# ============================================
# PB_DATA_DIR=./pb_data
# PB_ENCRYPTION_KEY=optional_additional_encryption_key

# ============================================
# Wallet Service Configuration
# ============================================
# URL for wallet generation API service
# For local dev: WALLET_SRV_URL=http://localhost:3001
# For Docker: WALLET_SRV_URL=http://wallet-api:3001
WALLET_SRV_URL=http://wallet-api:3001

# ============================================
# Security Notes
# ============================================
# 1. Never commit this file to git
# 2. Use different keys for dev/staging/production
# 3. Keep WALLET_MASTER_KEY secure - if lost, private keys are unrecoverable
# 4. Back up WALLET_MASTER_KEY in secure password manager
# 5. Rotate keys periodically in production
