# EggO PocketBase - Production Environment Variables
# Copy this file to .env.production and fill in your production values
# NEVER commit .env.production with real secrets to git
# Store these values securely in GitHub Secrets or a password manager

# ============================================
# LINE OAuth Configuration
# ============================================
# Get these from LINE Developers Console: https://developers.line.biz/console/
# Create a LINE Login channel and use the credentials for production
LINE_CHANNEL_ID=your-production-line-channel-id
LINE_CHANNEL_SECRET=your-production-line-channel-secret
LINE_CALLBACK_URL=https://pb.eggoworld.io/api/oauth2-redirect

# ============================================
# Wallet Encryption (CRITICAL)
# ============================================
# This key encrypts ALL user private keys in the database
# If lost, all encrypted private keys are PERMANENTLY UNRECOVERABLE
# Generate with: openssl rand -hex 32
# Store securely in a password manager and back up!
WALLET_MASTER_KEY=generate_with_openssl_rand_hex_32_minimum_32_chars_required

# ============================================
# DACC Wallet Configuration
# ============================================
# BIP39 mnemonic phrase for DACC blockchain wallet
# Generate using a secure BIP39-compliant tool
# Store securely and NEVER share
DACC_MNEMONIC=your-bip39-mnemonic-phrase-12-24-words

# ============================================
# PocketBase Admin Credentials
# ============================================
# Use STRONG unique credentials for production (min 16 chars recommended)
# These credentials have full admin access to your database
POCKETBASE_ADMIN_EMAIL=admin@eggo.local
POCKETBASE_ADMIN_PASSWORD=generate_strong_password_min_16_chars_with_mixed_case_numbers_symbols

# ============================================
# Application Configuration
# ============================================
APP_NAME=eggo-pb
APP_URL=https://pb.eggoworld.io
NODE_ENV=production

# ============================================
# Wallet Service Configuration
# ============================================
# URL for wallet generation API service
# For production with Docker: WALLET_SRV_URL=http://wallet-api:3001
# For external service: WALLET_SRV_URL=https://wallet.eggoworld.io
WALLET_SRV_URL=http://wallet-api:3001

# ============================================
# CORS Configuration
# ============================================
# Set to your production frontend domain(s)
# Multiple domains separated by comma
CORS_ORIGIN=https://eggoworld.io,https://www.eggoworld.io

# ============================================
# Wallet API Configuration
# ============================================
# Wallet API service port (internal Docker network)
PORT=3001

# ============================================
# Blockchain RPC Endpoints
# ============================================
# Get from QuickNode, Infura, Alchemy, or similar for production
# Public endpoints are shown here but should use private RPC for production
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# ============================================
# Contract Deployment (CRITICAL)
# ============================================
# NEVER commit real private keys to git
# Use a dedicated deployer wallet with minimum required permissions
DEPLOYER_PRIVATE_KEY=your-deployer-private-key-never-commit-to-git

# ============================================
# Frontend Configuration
# ============================================
# Public URLs accessible from frontend
NEXT_PUBLIC_POCKETBASE_URL=https://pb.eggoworld.io
NEXT_PUBLIC_WALLET_API_URL=https://wallet.eggoworld.io
NEXT_PUBLIC_CONTRACT_ADDRESSES_JSON_PATH=/contract-addresses.json

# ============================================
# Security Warnings
# ============================================
# 1. NEVER commit this file with real values to git
# 2. NEVER share WALLET_MASTER_KEY - it protects all user wallets
# 3. Use different credentials for dev/staging/production
# 4. Rotate secrets periodically (especially WALLET_MASTER_KEY)
# 5. Back up DACC_MNEMONIC and WALLET_MASTER_KEY securely
# 6. Use a password manager to store all secrets
# 7. Enable 2FA on all developer accounts