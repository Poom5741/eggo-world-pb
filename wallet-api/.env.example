# ⚠️  SECURITY WARNING: NEVER commit .env files to git!
# ⚠️  RELAYER_PRIVATE_KEY gives full control over relayer wallet
# ⚠️  Keep this file secure and rotate keys regularly

# Wallet API Environment Configuration
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001
NODE_ENV=development

# Blockchain Configuration
# BSC Mainnet (chain 56)
RPC_URL=https://bsc-dataseed.binance.org
CHAIN_ID=56

# Wallet Encryption (AES-256-GCM)
WALLET_MASTER_KEY=your-master-key-henerate-random-32-byte-key

# PocketBase Admin Credentials (for accessing user wallets)
PB_URL=https://pb.eggoworld.io
PB_ADMIN_EMAIL=admin@eggoworld.io
PB_ADMIN_PASSWORD=your-admin-password

# Gas Sponsorship (D-05)
# Platform relayer wallet private key - pays gas fees for user operations
# This wallet MUST have BNB balance to sponsor gas
# Generate with: ethers.Wallet.createRandom().privateKey
# NEVER commit this file to git!
RELAYER_PRIVATE_KEY=0x-your-relayer-wallet-private-key-here

# Contract Addresses (loaded from contracts/contract-addresses.json)
# These are optional overrides if you want to specify them here
# EGG_NFT_ADDRESS=0x...
# MARKETPLACE_ADDRESS=0x...
