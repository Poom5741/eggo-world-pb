# Wallet API Environment Variables
# Copy this file to .env.local and fill in your values

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Blockchain Configuration (0xl3 Testnet for Phase 12)
RPC_URL=https://rpc.0xl3.com
CHAIN_ID=7117
CONFIRMATIONS=12
GAS_BUFFER_PERCENT=20

# PocketBase Admin Configuration (for fetching encrypted private keys)
# Get these from your PocketBase instance
POCKETBASE_URL=https://pb.eggoworld.io
PB_ADMIN_EMAIL=admin@eggoworld.io
PB_ADMIN_PASSWORD=your_admin_password_here

# Contract Addresses (get from contracts/contract-addresses.json after deployment)
# Phase 12: Replace these with actual deployed addresses
# 0xl3 Testnet (Chain ID: 7117)
EGG_NFT_ADDRESS=0xb2FE193523A1E6A240141331A80755f5642e7A44
FOOD_NFT_ADDRESS=0xec21A3c068e84ceeD04975627418E867Ec342A02
COMMISSION_NFT_ADDRESS=0xa0C50587306F0CCac627D2eaEcb9e5909dB58F3f

# Wallet Encryption (DACC-JS)
WALLET_MASTER_KEY=your-32-byte-hex-master-key-here
DATA_STORAGE_NETWORK=opSepolia

# Security
MIN_PASSWORD_LENGTH=12
MAX_PASSWORD_LENGTH=120
PUBLIC_ENCRYPTION=false

# Gas Sponsorship (Phase 12 - optional)
# SPONSOR_WALLET=0x...  # Platform wallet for gas sponsorship
